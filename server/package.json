{
  "name": "knowwork-server",
  "version": "3.0.0",
  "description": "KnowWork monolith API — career intelligence platform",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev":      "nodemon src/server.js",
    "start":    "node src/server.js",
    "migrate":  "node scripts/migrate.js",
    "seed":     "node scripts/seed.js",
    "reset":    "node scripts/migrate.js --reset && node scripts/seed.js",
    "lint":     "eslint src --ext .js",
    "test":     "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.12.0",
    "bcryptjs":               "^2.4.3",
    "compression":            "^1.7.4",
    "cors":                   "^2.8.5",
    "dotenv":                 "^16.4.1",
    "express":                "^4.18.3",
    "express-rate-limit":     "^7.2.0",
    "express-validator":      "^7.0.1",
    "helmet":                 "^7.1.0",
    "ioredis":                "^5.3.2",
    "jsonwebtoken":           "^9.0.2",
    "mongoose":               "^8.2.0",
    "morgan":                 "^1.10.0",
    "multer":                 "^1.4.5-lts.1",
    "node-cron":              "^3.0.3",
    "pg":                     "^8.11.3",
    "uuid":                   "^9.0.1",
    "winston":                "^3.12.0",
    "winston-daily-rotate-file": "^4.7.1",
    "zod":                    "^3.22.4"
  },
  "devDependencies": {
    "eslint":              "^8.57.0",
    "nodemon":             "^3.1.0",
    "vitest":              "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "supertest":           "^7.0.0"
  }
}
